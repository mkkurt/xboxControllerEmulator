{
  "manifest_version": 3,
  "name": "CloudPad Bridge",
  "version": "1.0.0",
  "description": "Connect CloudPad controller emulator to cloud gaming platforms",
  "permissions": [],
  "host_permissions": [
    "https://www.xbox.com/*",
    "https://play.geforcenow.com/*",
    "https://luna.amazon.com/*",
    "https://stadia.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xbox.com/*/play/*",
        "https://play.geforcenow.com/*",
        "https://luna.amazon.com/*",
        "https://stadia.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
